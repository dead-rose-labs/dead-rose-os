pkgname=dead-rose-config
pkgver=0.1.0
pkgrel=1
pkgdesc='Dead Rose OS artwork, Plasma defaults and desktop entry points'
arch=('any')
url='https://github.com/dead-rose-labs/dead-rose-os'
license=('Apache-2.0')
depends=('plasma-desktop' 'sddm' 'plymouth' 'kdialog' 'python' 'chromium')
makedepends=('librsvg' 'noto-fonts')
source=('deadrose-assets.tar')
# Local source archive made from this checkout; never downloaded from a URL.
sha256sums=('SKIP')

build() {
    rsvg-convert -w 3840 -h 2160 branding/wallpapers/dead-rose.svg -o wallpaper.png
    rsvg-convert -w 96 -h 96 branding/icons/scalable/apps/dead-rose.svg -o logo.png
}

package() {
    local share="$pkgdir/usr/share" etc="$pkgdir/etc" conf
    install -dm755 "$share/dead-rose/installed" "$share/color-schemes" "$share/konsole" \
        "$share/plasma/look-and-feel/org.deadrose.desktop" "$share/plasma/desktoptheme/deadrose" \
        "$share/icons/deadrose" "$share/wallpapers/DeadRose/contents/images" \
        "$share/sddm/themes/deadrose" "$share/plymouth/themes/deadrose" \
        "$share/calamares/branding/deadrose" "$share/applications" \
        "$etc/skel/.config/menus" "$etc/sddm.conf.d" "$etc/plymouth" "$pkgdir/usr/bin" \
        "$share/libalpm/hooks" "$share/licenses/$pkgname"
    cp -r branding/plasma/look-and-feel/. "$share/plasma/look-and-feel/org.deadrose.desktop/"
    cp -r branding/plasma/desktoptheme/. "$share/plasma/desktoptheme/deadrose/"
    cp -r branding/icons/. "$share/icons/deadrose/"
    cp -r branding/sddm/. "$share/sddm/themes/deadrose/"
    cp -r branding/plymouth/. "$share/plymouth/themes/deadrose/"
    cp -r branding/calamares/. "$share/calamares/branding/deadrose/"
    install -m644 logo.png "$share/plymouth/themes/deadrose/"
    install -m644 wallpaper.png "$share/wallpapers/DeadRose/contents/images/3840x2160.png"
    install -m644 branding/wallpapers/metadata.json "$share/wallpapers/DeadRose/"
    install -m644 branding/colors/DeadRose.colors "$share/color-schemes/"
    install -m644 config/plasma/DeadRose.colorscheme "$share/konsole/DeadRose.colorscheme"
    install -m644 config/plasma/plasma-applications.menu "$etc/skel/.config/menus/"
    for conf in kdeglobals plasmarc kwinrc kcminputrc konsolerc; do
        install -m644 "config/plasma/$conf" "$etc/skel/.config/$conf"
    done
    cat branding/colors/DeadRose.colors >> "$etc/skel/.config/kdeglobals"
    install -m644 config/plasma/DeadRose.profile "$share/konsole/"
    install -m644 config/system/sddm.conf "$etc/sddm.conf.d/20-deadrose.conf"
    install -m644 config/system/plymouthd.conf "$etc/plymouth/plymouthd.conf"
    install -m644 config/system/os-release "$share/dead-rose/"
    install -m644 config/system/installed/* "$share/dead-rose/installed/"
    install -m644 config/system/identity.hook "$share/libalpm/hooks/99-dead-rose-identity.hook"
    install -m755 apps/dead-rose/dead-rose apps/web-app/dead-rose-web-app "$pkgdir/usr/bin/"
    install -m644 apps/dead-rose/*.desktop "$share/applications/"
    install -m644 LICENSE "$share/licenses/$pkgname/"
}
