[Unit]
Description=Validate Dead Rose installer live root
DefaultDependencies=no
RequiresMountsFor=/run/dead-rose-iso /sysroot
Before=initrd-root-fs.target
OnFailure=emergency.target
OnFailureJobMode=replace-irreversibly

[Service]
Type=oneshot
ExecStart=/usr/lib/dead-rose-initrd/mount-live-root
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
