[Unit]
Description=Mount Dead Rose installer live root
DefaultDependencies=no
Requires=run-dead\x2drose\x2diso.mount
After=run-dead\x2drose\x2diso.mount
Before=initrd-root-fs.target
OnFailure=emergency.target
OnFailureJobMode=replace-irreversibly

[Mount]
What=/run/dead-rose-iso/live/rootfs.squashfs
Where=/sysroot
Type=squashfs
Options=loop,ro
TimeoutSec=60s
