[Unit]
Description=Capture Dead Rose graphical startup diagnostics
After=greetd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/dead-rose/graphical-session-check
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log/dead-rose
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
StandardOutput=journal+console
StandardError=journal+console
