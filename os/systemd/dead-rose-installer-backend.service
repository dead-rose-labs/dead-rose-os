[Unit]
Description=Dead Rose privileged installer backend
After=local-fs.target systemd-udev-settle.service systemd-resolved.service
Wants=systemd-udev-settle.service systemd-resolved.service
Before=greetd.service

[Service]
Type=simple
User=root
Group=deadrose-installer-ipc
ExecStart=/usr/lib/dead-rose/dead-rose-installer-agent
Environment=DEAD_ROSE_PAYLOAD=/usr/lib/dead-rose-installer/dead-rose-os.rootfs.tar.gz
Environment=DEAD_ROSE_TARGET_MOUNT=/run/dead-rose-installer/target
Environment=DEAD_ROSE_INSTALLER_MEDIA=/dev/disk/by-label/DEAD_ROSE_INSTALLER
Restart=on-failure
RestartSec=3s
RuntimeDirectory=dead-rose-installer
RuntimeDirectoryMode=0750
UMask=0007
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# Curtin must preserve the Ubuntu rootfs ownership and SUID/SGID modes. On
# systemd 259, enabling this filter also makes GNU tar's openat2() fail with
# ENOSYS, preventing all rootfs extraction.
RestrictSUIDSGID=no
LockPersonality=yes

[Install]
WantedBy=multi-user.target
