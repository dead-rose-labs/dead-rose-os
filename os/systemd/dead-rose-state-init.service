[Unit]
Description=Apply persistent Dead Rose system identity
After=local-fs.target systemd-tmpfiles-setup.service
Before=dead-rose-core.service greetd.service

[Service]
Type=oneshot
ExecStart=/usr/lib/dead-rose/dead-rose-state-init
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/hostname /var/lib/dead-rose
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
