#!/usr/bin/bash
set -u

echo "DEAD_ROSE_SMOKE_DIAGNOSTICS_BEGIN"
for unit in \
  greetd.service \
  plymouth-quit.service \
  plymouth-quit-wait.service \
  systemd-user-sessions.service \
  dead-rose-installer-backend.service \
  installer-session-ready.service \
  install-driver.service; do
  state="$(systemctl is-active "$unit" 2>/dev/null || true)"
  case "$state" in
    active|activating|deactivating|inactive|failed) ;;
    *) state=unknown ;;
  esac
  echo "DEAD_ROSE_UNIT_STATE $unit $state"
  if systemctl is-failed --quiet "$unit"; then
    echo "DEAD_ROSE_FAILED_UNIT $unit"
  fi
done
for specification in \
  session:/usr/lib/dead-rose/dead-rose-session \
  cage:/usr/bin/cage \
  installer:/usr/lib/dead-rose/dead-rose-installer \
  backend:/usr/lib/dead-rose/dead-rose-installer-agent; do
  label="${specification%%:*}"
  executable="${specification#*:}"
  present=no
  for process in /proc/[0-9]*; do
    if [[ "$(readlink -f "$process/exe" 2>/dev/null || true)" == "$executable" ]]; then
      present=yes
      break
    fi
  done
  echo "DEAD_ROSE_PROCESS_STATE $label $present"
done
systemctl --failed --no-pager || true
loginctl list-sessions --no-pager || true
ps -eo user,pid,ppid,args | grep -E 'greetd|cage|dead-rose' || true
journalctl -b --no-pager -n 500 \
  -u greetd.service \
  -u dead-rose-core.service \
  -u dead-rose-installer-backend.service \
  -u dead-rose-session-ready.service \
  -u installer-session-ready.service \
  -u install-driver.service || true
for identity in deadrose-ui deadrose-installer; do
  if id "$identity" >/dev/null 2>&1; then
    journalctl -b --no-pager -n 300 "_UID=$(id -u "$identity")" || true
  fi
done
echo "DEAD_ROSE_SMOKE_DIAGNOSTICS_END"
