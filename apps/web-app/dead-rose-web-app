#!/usr/bin/env python3
"""Launch one HTTP(S) web app through Chromium's supported app mode."""
import os
import sys
from urllib.parse import urlsplit

if len(sys.argv) != 2:
    sys.exit('Usage: dead-rose-web-app https://service.example/')
url = sys.argv[1]
try:
    parsed = urlsplit(url)
    valid = parsed.scheme in ('https', 'http') and bool(parsed.hostname)
except ValueError:
    valid = False
if not valid or any(ord(c) < 32 for c in url):
    sys.exit('A valid HTTP(S) URL is required.')
os.execv('/usr/bin/chromium', ['chromium', '--app=' + url])
