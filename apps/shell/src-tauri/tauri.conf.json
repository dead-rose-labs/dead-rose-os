{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dead Rose OS",
  "version": "0.1.0",
  "identifier": "systems.deadrose.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Dead Rose OS",
        "decorations": false,
        "resizable": false,
        "backgroundColor": "#0b0b0c"
      }
    ]
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
