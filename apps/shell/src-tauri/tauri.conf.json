{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dead Rose OS",
  "version": "0.1.0",
  "identifier": "os.deadrose.shell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Dead Rose OS",
        "fullscreen": false,
        "decorations": false,
        "resizable": false,
        "devtools": false
      }
    ]
  },
  "bundle": { "active": false }
}
